# Alpaca paper trading keys — get them at https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "paper" (default) or "live" — live requires explicit intention and a live-trading account
ALPACA_ENV=paper

# "iex" (free tier) or "sip" (paid, $99/mo consolidated tape)
ALPACA_FEED=iex

# Shared secret for the backend API — any long random string works
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-random-secret

# Backend server port
PORT=8000

# SQLite database path (relative to backend/)
DATABASE_URL=ledger.db

# Quiver Quant API — congressional trading data (free tier)
# Sign up at https://www.quiverquant.com/signup
QUIVER_API_TOKEN=your-quiver-api-token-here
