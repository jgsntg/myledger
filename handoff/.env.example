# =============================================================================
# Ledger — environment variables
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# ---- Alpaca ----
# Get keys from https://alpaca.markets → Paper Trading dashboard → Generate New Key
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 'paper' or 'live'. Default to paper. Setting to 'live' should require a separate
# explicit confirmation flow in the UI; don't make this easy to flip accidentally.
ALPACA_ENV=paper

# 'iex' (free) or 'sip' (paid, $99/mo)
ALPACA_DATA_FEED=iex

# ---- Backend ----
# Shared secret the frontend sends in Authorization: Bearer header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SHARED_SECRET=

# Where the backend listens
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend ----
# Where the frontend should look for the backend
VITE_API_BASE_URL=http://localhost:8000

# ---- Database ----
# SQLite path (absolute or relative to backend working dir)
DATABASE_URL=sqlite:///./ledger.db

# ---- Notifications (Phase 3) ----
# Pick one. Resend is recommended for transactional email.
# Leave blank to disable email sending; events will still be logged.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=ledger@yourdomain.com
NOTIFICATION_TO_EMAIL=

# ---- Misc ----
# Comma-separated list of allowed origins for CORS in production
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log level: debug, info, warning, error
LOG_LEVEL=info
